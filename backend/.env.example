# Copy to backend/.env on the VPS and fill in real values. Never commit the real .env.

PORT=5000
NODE_ENV=production

# MongoDB (recommended: MongoDB Atlas connection string)
MONGO_URI=

# Redis (matches crm-redis in docker-compose.yml — use the container name as host)
REDIS_URL=redis://:REDIS_PASSWORD_HERE@crm-redis:6379

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=
SUPER_ADMIN_JWT_SECRET=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_NAMESPACE=

# DataCircles application session (dc_session cookie) — see
# backend/services/sessionService.js. Max concurrent sessions per user is
# fixed at 2 in code, not configurable via env var.
SESSION_TTL_DAYS=30

# Frontend URL (for CORS / redirects)
FRONTEND_URL=http://YOUR_VPS_IP:3000

# AWS S3 (file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
CLOUDFRONT_DOMAIN=

# Email
EMAIL_USER=
EMAIL_PASS=
MAIL_USER=

# SMS
FAST2SMS_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Decentro
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
DECENTRO_MODULE_SECRET=

# Zoom
ZOOM_API_KEY=
ZOOM_API_SECRET=

# Google service account (used for calendar/sheets integration)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# CAW-specific
CAW_MANDATE_CEILING_RUPEES=
CAW_REGISTRATION_LINK_EXPIRY_SECONDS=
