# Copy to .env (same folder as docker-compose.yml) on the VPS and fill in real values.
# Never commit the real .env.

REDIS_PASSWORD=

# Frontend build-time vars (baked into the static build at `docker compose build`)
VITE_APP_API_URL=http://YOUR_VPS_IP:5000
VITE_APP_AUTH0_DOMAIN=
VITE_APP_AUTH0_AUDIENCE=
VITE_APP_AUTH0_CLIENT_ID=
